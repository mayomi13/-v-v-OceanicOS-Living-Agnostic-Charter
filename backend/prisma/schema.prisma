generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Proposal {
  id        String   @id @default(cuid())
  title     String
  body      String?
  status    String   @default("open")
  createdAt DateTime @default(now())
}
