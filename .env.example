# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env files with secrets to version control

# ============================================
# Database Configuration
# ============================================

# PostgreSQL connection URL (required)
# Format: postgresql://user:password@host:port/database
# Local: postgresql://postgres:postgres@db:5432/vovv
# Production: Use strong password, dedicated DB user
DATABASE_URL="postgresql://postgres:postgres@db:5432/vovv"

# ============================================
# Backend Configuration
# ============================================

# Node environment (development, staging, production)
NODE_ENV="development"

# Backend port (default: 3000)
PORT="3000"

# Backend host (0.0.0.0 for Docker, localhost for local)
HOST="0.0.0.0"

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL="debug"

# Prisma query logging (true/false)
PRISMA_QUERY_LOGGING="true"

# ============================================
# Frontend Configuration
# ============================================

# Vite dev server host (0.0.0.0 for Docker, localhost for local)
VITE_HOST="0.0.0.0"

# Vite dev server port (default: 5173)
VITE_PORT="5173"

# API base URL for frontend
# Development (Docker): http://backend:3000 (handled by proxy)
# Development (Local): http://localhost:3000
# Production: https://api.youromain.com
VITE_API_URL="http://localhost:3000"

# ============================================
# Security Configuration
# ============================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Session secret (generate random string for production)
SESSION_SECRET="your-secret-key-change-in-production"

# API key for external services (if needed)
API_KEY="your-api-key-here"

# ============================================
# External Services (Optional)
# ============================================

# Sentry error tracking (optional)
SENTRY_DSN=""

# Email service configuration (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Redis cache (optional)
REDIS_URL=""

# ============================================
# CI/CD Configuration
# ============================================

# GitHub token for CI pipeline
GITHUB_TOKEN=""

# Docker registry credentials (if using private registry)
DOCKER_REGISTRY_URL=""
DOCKER_REGISTRY_USER=""
DOCKER_REGISTRY_PASS=""

# ============================================
# Monitoring & Analytics (Optional)
# ============================================

# Google Analytics
GOOGLE_ANALYTICS_ID=""

# DataDog APM
DATADOG_API_KEY=""
DATADOG_ENV="development"

# ============================================
# Notes
# ============================================

# Development:
# - Copy this file to .env.local
# - Use defaults or local values
# - .env.local is gitignored

# Production:
# - Use strong, randomly generated secrets
# - Store secrets in secure vault (e.g., AWS Secrets Manager)
# - Never commit .env files with real secrets
# - Rotate secrets regularly
# - Use separate credentials per environment
